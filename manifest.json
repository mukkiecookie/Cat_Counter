{
    "manifest_version": 3,
    "name": "Cat Counter",
    "version": "1.1.0",
    "description": "Count the cats you spot on the go, save your tally, and keep a running total across sessions.",
    "action": {
        "default_popup": "src/popup.html",
        "default_icon": {
            "16": "assets/caticon.png",
            "48": "assets/caticon.png",
            "128": "assets/caticon.png"
        }
    },
    "icons": {
        "16": "assets/caticon.png",
        "48": "assets/caticon.png",
        "128": "assets/caticon.png"
    },
    "permissions": ["storage"]
}
